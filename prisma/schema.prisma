generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CCTV {
  id               Int      @id @default(autoincrement())
  address          String
  purpose          String
  cameraCount      Int
  resolution       String
  direction        String
  storageDays      Int
  installationDate DateTime
  contactNumber    String
  latitude         Float
  longitude        Float
  dataUpdatedAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Apartment_Details {
  id                  Int      @id @default(autoincrement())
  address             String
  complexType         String
  complexNamePublic   String?
  complexNameBuilding String?
  complexNameRoad     String?
  complexUniqueId     String   @unique
  buildingCount       Int
  landUniqueId        String
  householdCount      Int
  approvalDate        DateTime
  buildingName        String?
  floorCount          Int
  latitude            Float
  longitude           Float
  marker              Apartment_Marker?

  favorites Favorite[] // ✅ 연결된 찜 목록
  transactions Apartment_Transaction[] // 거래 기록
  reports Report[] // 보고서

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Apartment_Marker {
  id              Int      @id @default(autoincrement())
  complexUniqueId String   @unique
  latitude        Float
  longitude       Float
  details         Apartment_Details? @relation(fields: [complexUniqueId], references: [complexUniqueId])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String
  role          String     @default("user") // "user" 또는 "agent"
  phoneNumber   String?
  profileImage  String?
  favorites     Favorite[] // ✅ 연결된 찜 목록
  reports       Report[]   // 보고서
  createdAt     DateTime   @default(now())
  posts         Post[]     // ✅ 이 줄이 필요해!
  comments      Comment[]
  notifications Notification[] // ✅ 이 줄을 추가!
  agent         Agent?     // 공인중개사 정보 (role이 "agent"인 경우)
  
  nickname       String?   // 🔜 닉네임도 같이 쓸 거니까 미리 넣어도 좋아
}

model Agent {
  id            String     @id @default(cuid())
  userId        Int        @unique
  user          User       @relation(fields: [userId], references: [id])
  email         String     @unique
  officeName    String
  officeAddress String
  licenseNumber String     @unique
  properties    Property[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Favorite {
  id              Int      @id @default(autoincrement())
  userId          Int
  complexUniqueId String
  createdAt       DateTime @default(now())

  // ✅ 관계 설정
  user      User              @relation(fields: [userId], references: [id])
  apartment Apartment_Details @relation(fields: [complexUniqueId], references: [complexUniqueId])

  @@unique([userId, complexUniqueId])
}

model FindRequest {
  id        Int      @id @default(autoincrement())
  phone     String
  types     String // 예: "원룸류,기타:고시원"
  dealType  String
  leaseTerm String? // dealType === "임차"일 경우만
  budget    String
  location  String
  moveIn    String // 예: "2주 이내,기타:내년 1월"
  note      String?
  createdAt DateTime @default(now())
}

model SellRequest {
  id           Int      @id @default(autoincrement())
  phone        String
  propertyType String // 체크리스트+기타 합친 값
  location     String
  price        String
  dealType     String // "매도" or "임대"
  note         String?
  createdAt    DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String? // 선택 사항
  category  String // 예: "자랑", "궁금해요", "잡담"
  views     Int      @default(0)
  authorId  Int?
  createdAt DateTime @default(now())

  author   User?     @relation(fields: [authorId], references: [id])
  comments Comment[]
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  post      Post      @relation(fields: [postId], references: [id])
  postId    Int
  author    User      @relation(fields: [authorId], references: [id])
  authorId  Int
  parentId  Int? // ← 대댓글용 (null이면 일반 댓글)
  children  Comment[] @relation("CommentChildren")
  parent    Comment?  @relation("CommentChildren", fields: [parentId], references: [id])
  createdAt DateTime  @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String // e.g. "comment"
  message   String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Apartment_Transaction {
  id              Int      @id @default(autoincrement())
  complexUniqueId String
  dealAmount      Int      // 거래금액
  dealYear        Int      // 거래년도
  dealMonth       Int      // 거래월
  dealDay         Int      // 거래일
  area            Float    // 전용면적
  floor           Int      // 층
  apartment       Apartment_Details @relation(fields: [complexUniqueId], references: [complexUniqueId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id              Int      @id @default(autoincrement())
  complexUniqueId String
  title           String
  content         String
  price           Int
  status          String   @default("pending") // pending, completed, failed
  userId          Int
  apartment       Apartment_Details @relation(fields: [complexUniqueId], references: [complexUniqueId])
  user            User     @relation(fields: [userId], references: [id])
  payment         Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        Int      @id @default(autoincrement())
  reportId  Int      @unique
  amount    Int
  method    String   // card, bank_transfer, etc.
  status    String   @default("pending") // pending, completed, failed
  report    Report   @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dong_Boundary {
  id        Int      @id @default(autoincrement())
  dongName  String   @unique
  boundary  Json     // GeoJSON 형식의 경계 데이터
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id             String    @id @default(cuid())
  title          String
  address        String
  dong           String
  complexName    String
  type           String    // 매매, 전세, 월세
  category       String    @default("주택") // 주택, 비주택
  price          Int       // 실제 연산용 가격: 단위는 원 (예: 120000000)
  priceDisplay   String    // 보기용 문자열: 예 "1억2천"
  area           Float
  pyung          Float
  floor          Int
  totalFloors    Int
  rooms          Int
  bathrooms      Int
  maintenanceFee String    // 관리비 (문자열로 저장)
  monthlyFee     Int?      // 월세 (실제 연산용)
  monthlyDisplay String?   // 월세 보기용 문자열
  deposit        Int?      // 전세/보증금 (실제 연산용)
  depositDisplay String?   // 전세/보증금 보기용 문자열
  direction      String
  description    String @db.Text
  images         Json      // String[] 대신 Json 타입 사용
  isVerified     Boolean   @default(false)
  isHidden       Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
