generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
}

model CCTV {
  id               Int      @id @default(autoincrement())
  address          String
  purpose          String
  cameraCount      Int
  resolution       String
  direction        String
  storageDays      Int
  installationDate DateTime
  contactNumber    String
  latitude         Float
  longitude        Float
  dataUpdatedAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(USER)
  phoneNumber         String?
  profileImage        String?
  nickname            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt @default(now())
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  bookmarks           Bookmark[]
  acceptedAnswersCount Int      @default(0)
  points              Point[]
  badges              Badge[]
  rank                String    @default("BRONZE")
  agent               Agent?
  favorites           Favorite[]
  notifications       Notification[]
  reports             Report[]

  @@index([email])
}

model Agent {
  id            String     @id @default(cuid())
  userId        Int        @unique
  user          User       @relation(fields: [userId], references: [id])
  email         String     @unique
  officeName    String
  officeAddress String
  licenseNumber String     @unique
  properties    Property[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  kaptCode  String
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id])
  apartment ApartmentBasicInfo @relation(fields: [kaptCode], references: [kaptCode])

  @@unique([userId, kaptCode])
}

model FindRequest {
  id        Int      @id @default(autoincrement())
  phone     String
  types     String
  dealType  String
  leaseTerm String?
  budget    String
  location  String
  moveIn    String
  note      String?
  createdAt DateTime @default(now())
}

model SellRequest {
  id           Int      @id @default(autoincrement())
  phone        String
  propertyType String
  location     String
  price        String
  dealType     String
  note         String?
  createdAt    DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  category  String
  views     Int      @default(0)
  authorId  Int?
  createdAt DateTime @default(now())
  isAgentOnly Boolean @default(false)

  author   User?     @relation(fields: [authorId], references: [id])
  comments Comment[]
  likes    Like[]
  bookmarks Bookmark[]
  postViews PostView[]
  notifications Notification[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isAccepted Boolean @default(false)
  
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId  Int?
  replies   Comment[] @relation("CommentReplies")
  notifications Notification[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // "COMMENT", "REPLY", "ACCEPT"
  message   String
  postId    Int?
  commentId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  comment   Comment? @relation(fields: [commentId], references: [id])

  @@index([userId])
}

model Report {
  id        Int                @id @default(autoincrement())
  kaptCode  String
  title     String
  content   String
  price     Int
  status    String             @default("pending")
  userId    Int
  apartment ApartmentBasicInfo @relation(fields: [kaptCode], references: [kaptCode])
  user      User               @relation(fields: [userId], references: [id])
  payment   Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id       Int    @id @default(autoincrement())
  reportId Int    @unique
  amount   Int
  method   String
  status   String @default("pending")
  report   Report @relation(fields: [reportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dong_Boundary {
  id        Int      @id @default(autoincrement())
  dongName  String   @unique
  boundary  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id             String    @id @default(cuid())
  title          String
  address        String
  dong           String
  complexName    String
  type           String
  category       String    @default("주택")
  price          Int
  priceDisplay   String
  area           Float
  pyung          Float
  floor          Int
  totalFloors    Int
  rooms          Int
  bathrooms      Int
  maintenanceFee String
  monthlyFee     Int?
  monthlyDisplay String?
  deposit        Int?
  depositDisplay String?
  direction      String
  description    String    @db.Text
  images         Json
  isVerified     Boolean   @default(false)
  isHidden       Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model ApartmentBasicInfo {
  kaptCode      String  @id
  kaptName      String
  bjdCode       String?
  as1           String?
  as2           String?
  as3           String?
  as4           String?
  createdAt     DateTime @default(now())
  
  kaptAddr      String?
  codeSaleNm    String?
  codeHeatNm    String?
  kaptTarea     Float?
  kaptDongCnt   Int?
  kaptdaCnt     String?
  kaptBcompany  String?
  kaptAcompany  String?
  kaptTel       String?
  kaptFax       String?
  kaptUrl       String?
  codeAptNm     String?
  doroJuso      String?
  hoCnt         Int?
  codeMgrNm     String?
  codeHallNm    String?
  kaptUsedate   String?
  kaptMarea     Float?
  kaptMparea60  Float?
  kaptMparea85  Float?
  kaptMparea135 Float?
  kaptMparea136 Float?
  privArea      Float?
  
  kaptTopFloor  Int?
  ktownFlrNo    Int?
  kaptBaseFloor Int?
  kaptdEcntp    Int?
  zipcode       String?
  
  lat           Float?
  lng           Float?

  // ✅ 상세정보와 1:1
  detailedInfo ApartmentDetailedInfo? @relation("BasicToDetail")

  // ✅ 거래정보와 1:N
  transactions ApartmentTransaction[] @relation("BasicToTransaction")

  favorites Favorite[]
  reports   Report[]
}

model ApartmentDetailedInfo {
  kaptCode                String  @id
  kaptName                String?
  codeMgr                 String?
  kaptMgrCnt              Int?
  kaptCcompany            String?
  codeSec                 String?
  kaptdScnt               Int?
  kaptdSecCom             String?
  codeClean               String?
  kaptdClcnt              Int?
  codeGarbage             String?
  codeDisinf              String?
  kaptdDcnt               Int?
  disposalType            String?
  codeStr                 String?
  kaptdEcapa              Int?
  codeEcon                String?
  codeEmgr                String?
  codeFalarm              String?
  codeWsupply             String?
  codeElev                String?
  kaptdEcnt               Int?
  kaptdPcnt               Int?
  kaptdPcntu              Int?
  codeNet                 String?
  kaptdCccnt              Int?
  welfareFacility         String?
  kaptdWtimebus           String?
  subwayLine              String?
  subwayStation           String?
  kaptdWtimesub           String?
  convenientFacility      String?
  educationFacility       String?
  groundElChargerCnt      Int?
  undergroundElChargerCnt Int?

  // ✅ 반대 관계에서 이름 맞춰줌
  basicInfo ApartmentBasicInfo @relation("BasicToDetail", fields: [kaptCode], references: [kaptCode])
}

model ApartmentTransaction {
  id             Int      @id @default(autoincrement())
  kaptCode       String
  dealType       String   // "매매" | "전세" | "월세"
  saleAmount     Int?     // 매매가
  depositAmount  Int?     // 전세 보증금 or 월세 보증금
  monthlyAmount  Int?     // 월세
  area           Float
  dealYear       Int
  dealMonth      Int
  dealDay        Int
  floor          Int
  aptNm          String?
  jibun          String?
  buildYear      Int?

  // 💡 여기에 relation 이름 추가!
  basicInfo ApartmentBasicInfo @relation("BasicToTransaction", fields: [kaptCode], references: [kaptCode])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kaptCode, dealYear, dealMonth, dealDay, floor, dealType])
}

model Like {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Point {
  id        Int      @id @default(autoincrement())
  amount    Int
  reason    String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model Badge {
  id          Int      @id @default(autoincrement())
  badgeId     String   @unique
  name        String
  description String
  imageUrl    String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromotionPost {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int
  viewedAt  DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, viewedAt])
}

